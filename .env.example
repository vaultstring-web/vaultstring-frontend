# API gateway (browser requests are proxied via Next.js rewrites to this URL)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:9000

# Optional: used by Next.js server-side rewrites in Docker
# GATEWAY_INTERNAL_URL=http://kyd-gateway:8080

# Optional: verbose API logging in the browser console
# NEXT_PUBLIC_DEBUG_API=true

# Google OAuth is configured on the backend (kyd-payment-system/.env), not here.
# For local mock Google (no GCP credentials): set GOOGLE_MOCK_MODE=true on the auth service.
# In Google Cloud Console, add this authorized redirect URI:
#   http://localhost:3012/google-callback

# Customer app port (pnpm dev): http://localhost:3012
See also [LOCAL_TESTING.md](../docs/LOCAL_TESTING.md) and [MANUAL_SETUP_AND_OPERATIONS.md](../docs/MANUAL_SETUP_AND_OPERATIONS.md) for full stack verification steps.
